{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>NethServer/.github:ns8-automerge"],
  "packageRules": [
    {
      "matchPackageNames": ["marcpope/borgbackupserver"],
      "allowedVersions": "/^v/",
      "automerge": false,
      "minimumReleaseAge": "1 day",
      "rebaseWhen": "auto",
      "separateMinorPatch": false
    }
  ]
}
