#!/usr/bin/env python3

import json
import subprocess
import sys

import agent


def validation_error(field, error, value=None):
    agent.set_status("validation-failed")
    json.dump(
        [{"field": field, "parameter": field, "value": value, "error": error}],
        fp=sys.stdout,
    )
    sys.exit(3)


request = json.load(sys.stdin)
password = request["password"]
if not isinstance(password, str):
    validation_error("password", "invalid_admin_password")
if not isinstance(request["reset_2fa"], bool):
    validation_error("reset_2fa", "invalid_value")
password_bytes = password.encode("utf-8")
if (
    not 8 <= len(password_bytes) <= 72
    or any(char in password for char in "\r\n\x00")
):
    validation_error("password", "invalid_admin_password")

command = ["bbs-reset-admin-password", "--standard-admin", "--password-stdin"]
if request["reset_2fa"]:
    command.extend(["--reset-2fa", "--yes"])

try:
    result = subprocess.run(
        command,
        input=password_bytes,
        capture_output=True,
        check=False,
        timeout=60,
    )
except (OSError, subprocess.TimeoutExpired):
    agent.assert_exp(False, "Could not run the BBS administrator password reset")

if result.returncode != 0:
    error = result.stderr.decode("utf-8", errors="replace").strip()
    agent.assert_exp(False, error or "BBS administrator password reset failed")

json.dump({}, fp=sys.stdout)
