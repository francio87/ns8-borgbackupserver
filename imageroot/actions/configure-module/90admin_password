import json
import subprocess
import sys
import time

import agent


def bootstrap_completed():
    # schema.sql creates admin with the '!' placeholder; the entrypoint
    # replaces it with the ADMIN_PASS hash at the end of its first run.
    try:
        result = subprocess.run(
            [
                "podman",
                "exec",
                "bbs",
                "mysql",
                "bbs",
                "-N",
                "-B",
                "-e",
                "SELECT password_hash FROM users WHERE username='admin'",
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and result.stdout.strip() not in ("", "!")


request = json.load(sys.stdin)
admin_password = request.get("admin_password", "")
if not admin_password:
    sys.exit(0)

# Setting the password before the entrypoint writes its own hash would
# let the entrypoint overwrite it.
deadline = time.monotonic() + 300
while not bootstrap_completed():
    agent.assert_exp(
        time.monotonic() < deadline,
        "BBS did not complete its first initialization",
    )
    time.sleep(2)

try:
    result = subprocess.run(
        ["bbs-reset-admin-password", "--standard-admin", "--password-stdin"],
        input=admin_password.encode("utf-8"),
        capture_output=True,
        check=False,
        timeout=60,
    )
except (OSError, subprocess.TimeoutExpired):
    agent.assert_exp(False, "Could not set the BBS administrator password")

if result.returncode != 0:
    error = result.stderr.decode("utf-8", errors="replace").strip()
    agent.assert_exp(False, error or "Could not set the BBS administrator password")

agent.set_env("BBS_ADMIN_PASSWORD_SET", "1")
