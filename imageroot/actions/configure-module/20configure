import json
import os
import subprocess
import sys

import agent


def validation_error(field, error, value):
    agent.set_status("validation-failed")
    json.dump(
        [{"field": field, "parameter": field, "value": value, "error": error}],
        fp=sys.stdout,
    )
    sys.exit(3)


request = json.load(sys.stdin)
fqdn = request["fqdn"].strip().lower()
ssh_port = request["ssh_port"]
admin_password = request.get("admin_password", "")
current_port = int(os.environ.get("BBS_SSH_PORT", "0") or 0)
web_port = int(os.environ["TCP_PORT"])
password_set = os.environ.get("BBS_ADMIN_PASSWORD_SET") == "1"

if admin_password:
    if password_set:
        validation_error(
            "admin_password", "admin_password_already_initialized", None
        )
    if (
        not isinstance(admin_password, str)
        or not 8 <= len(admin_password.encode("utf-8")) <= 72
        or any(char in admin_password for char in "\r\n\x00")
    ):
        validation_error("admin_password", "invalid_admin_password", None)
elif not password_set:
    # 90admin_password sets it through stdin, so it never reaches the
    # container environment, the module state or the logs.
    validation_error("admin_password", "admin_password_required", None)

# A copy made by clone-module must not reuse the FQDN of its source.
clone_pending = os.environ.get("BBS_CLONE_PENDING") == "1"
if clone_pending and fqdn == os.environ.get("BBS_FQDN", "").lower():
    validation_error("fqdn", "fqdn_used_by_clone_source", fqdn)

# The NS8 checker sees listening sockets. Check the allocated web port
# explicitly too, because it may not be listening until the service starts.
port_is_ours = False
if ssh_port == current_port:
    current_mapping = subprocess.run(
        ["podman", "port", "bbs", "22/tcp"],
        capture_output=True,
        text=True,
        check=False,
    )
    port_is_ours = current_mapping.returncode == 0 and any(
        line.rstrip().endswith(f":{ssh_port}")
        for line in current_mapping.stdout.splitlines()
    )
if ssh_port == web_port or (
    not port_is_ours and agent.tcp_port_in_use(ssh_port)
):
    validation_error("ssh_port", "port_in_use", ssh_port)

agent.set_route(
    {
        "instance": os.environ["MODULE_ID"],
        "url": f"http://127.0.0.1:{web_port}",
        "host": fqdn,
        "lets_encrypt": request["lets_encrypt"],
        "http2https": True,
    }
)
agent.assert_exp(
    agent.add_public_service(
        os.environ["MODULE_ID"], [f"{ssh_port}/tcp"], replace_ports=True
    ),
    "Cannot update the NS8 firewall rule for the BBS SSH port",
)

agent.mset_env(
    {
        "BBS_FQDN": fqdn,
        "BBS_LETS_ENCRYPT": str(request["lets_encrypt"]).lower(),
        "BBS_SSH_PORT": str(ssh_port),
    }
)
if clone_pending:
    agent.unset_env("BBS_CLONE_PENDING")
json.dump({}, fp=sys.stdout)
