import json
import os
import subprocess
import sys

import agent

request = json.load(sys.stdin)

if not request.get("replace"):
    # Copy: the route and the firewall rule are created by
    # configure-module, when the new FQDN and SSH port are set.
    sys.exit(0)

# Move: the core does not run configure-module, so publish the web
# interface and open the Borg SSH port here.
agent.set_route(
    {
        "instance": os.environ["MODULE_ID"],
        "url": f"http://127.0.0.1:{os.environ['TCP_PORT']}",
        "host": os.environ["BBS_FQDN"],
        "lets_encrypt": os.environ.get("BBS_LETS_ENCRYPT", "false") == "true",
        "http2https": True,
    }
)
agent.assert_exp(
    agent.add_public_service(
        os.environ["MODULE_ID"],
        [f"{os.environ['BBS_SSH_PORT']}/tcp"],
        replace_ports=True,
    ),
    "Cannot update the NS8 firewall rule for the BBS SSH port",
)

active = subprocess.run(
    ["systemctl", "--user", "is-active", "borgbackupserver.service"],
    capture_output=True,
    text=True,
    check=False,
)
agent.assert_exp(
    active.stdout.strip() == "active",
    "The Borg Backup Server service is not running after the move",
)
