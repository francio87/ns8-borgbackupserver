import json
import sys

import agent

request = json.load(sys.stdin)

if request.get("replace"):
    # Move: the source instance is removed after the transfer, so this
    # instance keeps its FQDN and SSH port and starts normally.
    sys.exit(0)

# Copy: the source instance keeps running with the same FQDN and SSH
# port. Do not let the core 90finalize step enable and start the
# service: it starts with the next configure-module run, which must set
# a different FQDN. The file is a space-separated list of units.
with open("default-target.clone-module", encoding="utf-8") as stream:
    units = stream.read().split()
units = [unit for unit in units if unit != "borgbackupserver.service"]
with open("default-target.clone-module", "w", encoding="utf-8") as stream:
    stream.write(" ".join(units) + "\n")

agent.set_env("BBS_CLONE_PENDING", "1")
print("Clone is waiting for a new FQDN and SSH port", file=sys.stderr)
