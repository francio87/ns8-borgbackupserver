#!/usr/bin/env python3

import argparse
import getpass
import re
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description="Reset the password of a BBS administrator")
    parser.add_argument(
        "--reset-2fa",
        action="store_true",
        help="also disable BBS 2FA and delete the recovery codes",
    )
    parser.add_argument("--standard-admin", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--password-stdin", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--yes", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    non_interactive = args.standard_admin and args.password_stdin
    if args.standard_admin != args.password_stdin or (args.yes and not non_interactive):
        print("Invalid non-interactive options", file=sys.stderr)
        return 1
    if non_interactive and args.reset_2fa and not args.yes:
        print("Non-interactive 2FA removal requires confirmation", file=sys.stderr)
        return 1
    if not non_interactive and not sys.stdin.isatty():
        print("Run this command from an interactive terminal", file=sys.stderr)
        return 1

    account_filter = " AND username='admin'" if non_interactive else ""
    try:
        result = subprocess.run(
            [
                "podman",
                "exec",
                "bbs",
                "mysql",
                "bbs",
                "-N",
                "-B",
                "-e",
                "SELECT id, username, COALESCE(auth_provider, '') "
                f"FROM users WHERE role='admin'{account_filter} ORDER BY id",
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None

    if result is None or result.returncode != 0:
        print("Cannot read administrators from the BBS database", file=sys.stderr)
        return 1

    admins = {}
    try:
        for line in result.stdout.splitlines():
            user_id, username, provider = line.split("\t", 2)
            admins[int(user_id)] = (username, provider)
    except (TypeError, ValueError):
        print("Unexpected response from the BBS database", file=sys.stderr)
        return 1

    if not admins:
        message = (
            "Standard BBS 'admin' account not found"
            if non_interactive
            else "No BBS administrator accounts found"
        )
        print(message, file=sys.stderr)
        return 1
    if non_interactive and len(admins) != 1:
        print("Standard BBS 'admin' account is not unique", file=sys.stderr)
        return 1

    if non_interactive:
        user_id = next(iter(admins))
        password_bytes = sys.stdin.buffer.read(73)
        try:
            password = password_bytes.decode("utf-8")
        except UnicodeDecodeError:
            print("The password must be valid UTF-8", file=sys.stderr)
            return 1
    else:
        print("BBS administrator accounts:")
        for user_id, (username, provider) in admins.items():
            print(f"  ID {user_id}: {username} (provider: {provider or 'not set'})")

        try:
            selected_id = input("ID of the account to update: ").strip()
            if not selected_id.isdecimal() or int(selected_id) not in admins:
                print("Invalid administrator ID", file=sys.stderr)
                return 1

            if args.reset_2fa:
                confirmation = input(
                    "Also disable BBS 2FA and delete the recovery codes? [y/N]: "
                ).strip().lower()
                if confirmation != "y":
                    print("Operation cancelled", file=sys.stderr)
                    return 1

            password = getpass.getpass("New password (8 to 72 characters): ")
            confirmation = getpass.getpass("Repeat the new password: ")
        except (EOFError, KeyboardInterrupt):
            print("Operation cancelled", file=sys.stderr)
            return 1

        password_bytes = password.encode("utf-8")
        if password != confirmation:
            print("The passwords do not match", file=sys.stderr)
            return 1

    if (
        not 8 <= len(password_bytes) <= 72
        or any(char in password for char in "\r\n\x00")
    ):
        print("The password must be 8 to 72 characters on one line "
            "(accented letters, symbols and emoji count as 2 to 4 characters)", file=sys.stderr)
        return 1

    try:
        hashed = subprocess.run(
            [
                "podman",
                "exec",
                "-i",
                "bbs",
                "php",
                "-r",
                "$password = stream_get_contents(STDIN); "
                "$hash = password_hash($password, PASSWORD_BCRYPT); "
                "if ($hash === false) { exit(1); } echo $hash;",
            ],
            input=password_bytes,
            capture_output=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        hashed = None

    if hashed is None or hashed.returncode != 0:
        print("Cannot generate the bcrypt hash in the BBS container", file=sys.stderr)
        return 1

    try:
        password_hash = hashed.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        print("The BBS container did not return a valid bcrypt hash", file=sys.stderr)
        return 1
    if not re.fullmatch(r"\$2[aby]\$\d{2}\$[./A-Za-z0-9]{53}", password_hash):
        print("The BBS container did not return a valid bcrypt hash", file=sys.stderr)
        return 1

    if not non_interactive:
        user_id = int(selected_id)
    totp_update = (
        ", totp_secret=NULL, totp_enabled=0, totp_enabled_at=NULL"
        if args.reset_2fa
        else ""
    )
    account_guard = " AND username='admin'" if non_interactive else ""
    sql = (
        "START TRANSACTION;\n"
        f"UPDATE users SET password_hash='{password_hash}'{totp_update} "
        f"WHERE id={user_id} AND role='admin'{account_guard};\n"
        "SET @password_updated = ROW_COUNT();\n"
        f"DELETE FROM password_resets WHERE user_id={user_id} "
        "AND @password_updated=1;\n"
    )
    if args.reset_2fa:
        sql += (
            f"DELETE FROM recovery_codes WHERE user_id={user_id} "
            "AND @password_updated=1;\n"
        )
    sql += "SELECT @password_updated;\nCOMMIT;\n"
    try:
        updated = subprocess.run(
            ["podman", "exec", "-i", "bbs", "mysql", "bbs", "-N", "-B"],
            input=sql,
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        updated = None

    if updated is None or updated.returncode != 0:
        print("Update failed; check that the BBS database is available", file=sys.stderr)
        return 1
    if updated.stdout.strip() != "1":
        print("The selected account is no longer an administrator; no password was updated", file=sys.stderr)
        return 1

    print(f"Password updated for administrator account {admins[user_id][0]} (ID {user_id})")
    print("Any password recovery tokens have been invalidated")
    if args.reset_2fa:
        print("BBS 2FA disabled; TOTP secret and recovery codes deleted")
    return 0


if __name__ == "__main__":
    sys.exit(main())
