#!/usr/bin/env python3

import argparse
import getpass
import re
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description="Reimposta la password di un amministratore BBS")
    parser.add_argument(
        "--reset-2fa",
        action="store_true",
        help="disattiva anche la 2FA BBS ed elimina i codici di recupero",
    )
    parser.add_argument("--standard-admin", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--password-stdin", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--yes", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    non_interactive = args.standard_admin and args.password_stdin
    if args.standard_admin != args.password_stdin or (args.yes and not non_interactive):
        print("Opzioni non interattive non valide", file=sys.stderr)
        return 1
    if non_interactive and args.reset_2fa and not args.yes:
        print("La rimozione 2FA non interattiva richiede conferma", file=sys.stderr)
        return 1
    if not non_interactive and not sys.stdin.isatty():
        print("Eseguire questo comando da un terminale interattivo", file=sys.stderr)
        return 1

    account_filter = " AND username='admin'" if non_interactive else ""
    try:
        result = subprocess.run(
            [
                "podman",
                "exec",
                "bbs",
                "mysql",
                "bbs",
                "-N",
                "-B",
                "-e",
                "SELECT id, username, COALESCE(auth_provider, '') "
                f"FROM users WHERE role='admin'{account_filter} ORDER BY id",
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None

    if result is None or result.returncode != 0:
        print("Impossibile leggere gli amministratori dal database BBS", file=sys.stderr)
        return 1

    admins = {}
    try:
        for line in result.stdout.splitlines():
            user_id, username, provider = line.split("\t", 2)
            admins[int(user_id)] = (username, provider)
    except (TypeError, ValueError):
        print("Risposta inattesa dal database BBS", file=sys.stderr)
        return 1

    if not admins:
        message = (
            "Account BBS standard 'admin' non trovato"
            if non_interactive
            else "Non sono presenti account amministratore BBS"
        )
        print(message, file=sys.stderr)
        return 1
    if non_interactive and len(admins) != 1:
        print("L'account BBS standard 'admin' non è univoco", file=sys.stderr)
        return 1

    if non_interactive:
        user_id = next(iter(admins))
        password_bytes = sys.stdin.buffer.read(73)
        try:
            password = password_bytes.decode("utf-8")
        except UnicodeDecodeError:
            print("La password deve essere UTF-8 valida", file=sys.stderr)
            return 1
    else:
        print("Account amministratore BBS:")
        for user_id, (username, provider) in admins.items():
            print(f"  ID {user_id}: {username} (provider: {provider or 'non indicato'})")

        try:
            selected_id = input("ID dell'account da aggiornare: ").strip()
            if not selected_id.isdecimal() or int(selected_id) not in admins:
                print("ID amministratore non valido", file=sys.stderr)
                return 1

            if args.reset_2fa:
                confirmation = input(
                    "Disattivare anche la 2FA BBS ed eliminare i codici di recupero? [y/N]: "
                ).strip().lower()
                if confirmation != "y":
                    print("Operazione annullata", file=sys.stderr)
                    return 1

            password = getpass.getpass("Nuova password (da 8 a 72 byte): ")
            confirmation = getpass.getpass("Ripeti la nuova password: ")
        except (EOFError, KeyboardInterrupt):
            print("Operazione annullata", file=sys.stderr)
            return 1

        password_bytes = password.encode("utf-8")
        if password != confirmation:
            print("Le password non coincidono", file=sys.stderr)
            return 1

    if (
        not 8 <= len(password_bytes) <= 72
        or any(char in password for char in "\r\n\x00")
    ):
        print("La password deve essere lunga da 8 a 72 byte e stare su una riga", file=sys.stderr)
        return 1

    try:
        hashed = subprocess.run(
            [
                "podman",
                "exec",
                "-i",
                "bbs",
                "php",
                "-r",
                "$password = stream_get_contents(STDIN); "
                "$hash = password_hash($password, PASSWORD_BCRYPT); "
                "if ($hash === false) { exit(1); } echo $hash;",
            ],
            input=password_bytes,
            capture_output=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        hashed = None

    if hashed is None or hashed.returncode != 0:
        print("Impossibile generare l'hash bcrypt nel container BBS", file=sys.stderr)
        return 1

    try:
        password_hash = hashed.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        print("Il container BBS non ha restituito un hash bcrypt valido", file=sys.stderr)
        return 1
    if not re.fullmatch(r"\$2[aby]\$\d{2}\$[./A-Za-z0-9]{53}", password_hash):
        print("Il container BBS non ha restituito un hash bcrypt valido", file=sys.stderr)
        return 1

    if not non_interactive:
        user_id = int(selected_id)
    totp_update = (
        ", totp_secret=NULL, totp_enabled=0, totp_enabled_at=NULL"
        if args.reset_2fa
        else ""
    )
    account_guard = " AND username='admin'" if non_interactive else ""
    sql = (
        "START TRANSACTION;\n"
        f"UPDATE users SET password_hash='{password_hash}'{totp_update} "
        f"WHERE id={user_id} AND role='admin'{account_guard};\n"
        "SET @password_updated = ROW_COUNT();\n"
        f"DELETE FROM password_resets WHERE user_id={user_id} "
        "AND @password_updated=1;\n"
    )
    if args.reset_2fa:
        sql += (
            f"DELETE FROM recovery_codes WHERE user_id={user_id} "
            "AND @password_updated=1;\n"
        )
    sql += "SELECT @password_updated;\nCOMMIT;\n"
    try:
        updated = subprocess.run(
            ["podman", "exec", "-i", "bbs", "mysql", "bbs", "-N", "-B"],
            input=sql,
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        updated = None

    if updated is None or updated.returncode != 0:
        print("Aggiornamento non riuscito; controllare che il database BBS sia disponibile", file=sys.stderr)
        return 1
    if updated.stdout.strip() != "1":
        print("L'account selezionato non è più un amministratore; nessuna password aggiornata", file=sys.stderr)
        return 1

    print(f"Password aggiornata per l'account amministratore {admins[user_id][0]} (ID {user_id})")
    print("Gli eventuali token di recupero password sono stati invalidati")
    if args.reset_2fa:
        print("2FA BBS disattivata; segreto TOTP e codici di recupero eliminati")
    return 0


if __name__ == "__main__":
    sys.exit(main())
