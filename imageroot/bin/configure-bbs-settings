#!/usr/bin/env python3

import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request


fqdn = os.environ.get("BBS_FQDN", "")
if not re.fullmatch(
    r"(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))+",
    fqdn,
):
    print("BBS_FQDN is missing or invalid", file=sys.stderr)
    sys.exit(1)

# Apache starts as the entrypoint's last step, so an HTTP answer means BBS finished bootstrapping
url = f"http://127.0.0.1:{os.environ['TCP_PORT']}/"
for _ in range(280):
    try:
        urllib.request.urlopen(url, timeout=5)
        break
    except urllib.error.HTTPError:
        break
    except OSError:
        time.sleep(1)
else:
    print("BBS did not become ready; cannot apply BBS server hostname", file=sys.stderr)
    sys.exit(1)

sql = (
    "INSERT INTO settings (`key`,`value`) "
    f"VALUES ('server_host','{fqdn}') "
    f"ON DUPLICATE KEY UPDATE `value`='{fqdn}'"
)
subprocess.run(["podman", "exec", "bbs", "mysql", "bbs", "-N", "-e", sql], check=True)

subprocess.run(
    [
        "podman",
        "exec",
        "bbs",
        "sed",
        "-i",
        f"s|^APP_URL=.*|APP_URL=https://{fqdn}|",
        "/var/bbs/config/.env",
    ],
    check=True,
)
