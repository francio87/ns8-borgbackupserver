#!/usr/bin/env python3

import os
import re
import subprocess
import sys
import time


fqdn = os.environ.get("BBS_FQDN", "")
if not re.fullmatch(
    r"(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))+",
    fqdn,
):
    print("BBS_FQDN is missing or invalid", file=sys.stderr)
    sys.exit(1)

sql = (
    "INSERT INTO settings (`key`,`value`) "
    f"VALUES ('server_host','{fqdn}') "
    f"ON DUPLICATE KEY UPDATE `value`='{fqdn}'"
)
for _ in range(180):
    result = subprocess.run(
        ["podman", "exec", "bbs", "mysql", "bbs", "-N", "-e", sql],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if result.returncode == 0:
        break
    time.sleep(1)
else:
    print("MariaDB did not become ready; cannot apply BBS server hostname", file=sys.stderr)
    sys.exit(1)

subprocess.run(
    [
        "podman",
        "exec",
        "bbs",
        "sed",
        "-i",
        f"s|^APP_URL=.*|APP_URL=https://{fqdn}|",
        "/var/bbs/config/.env",
    ],
    check=True,
)

try:
    password_initialized = (
        subprocess.run(
            ["bbs-admin-initialized"], check=False, timeout=15
        ).returncode
        == 0
    )
except (OSError, subprocess.TimeoutExpired):
    password_initialized = False

if password_initialized:
    password_file = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
    try:
        os.unlink(password_file)
    except FileNotFoundError:
        pass
